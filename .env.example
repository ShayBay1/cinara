# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app,
# so never put secret keys (Stripe secret key, Supabase service-role key) here.

# Supabase project (Settings > API). Leave blank to run on built-in sample data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Your website, where memberships and gifts are sold through Stripe.
EXPO_PUBLIC_WEB_URL=https://snippets.example

# iPhone/Android apps never sell anything. Set to "true" only if you decide to
# show a "Join on our website" link inside the native apps (allowed in the US
# App Store today; Apple may charge a fee on linked purchases - check first).
EXPO_PUBLIC_ALLOW_EXTERNAL_PURCHASE_LINK=false
